{
	"name": "z21-ui",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"prefix": "z21",
	"sourceRoot": "apps/z21-ui/src",
	"tags": ["type:ui-app", "scope:z21", "platform:browser"],
	"targets": {
		"build": {
			"executor": "@angular/build:application",
			"outputs": ["{options.outputPath}"],
			"defaultConfiguration": "production",
			"options": {
				"outputPath": "dist/apps/z21-ui",
				"browser": "apps/z21-ui/src/main.ts",
				"tsConfig": "apps/z21-ui/tsconfig.app.json",
				"inlineStyleLanguage": "scss",
				"assets": [
					{
						"glob": "**/*",
						"input": "apps/z21-ui/public"
					}
				],
				"styles": ["apps/z21-ui/src/styles.scss"]
			},
			"configurations": {
				"production": {
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "500kb",
							"maximumError": "1mb"
						},
						{
							"type": "anyComponentStyle",
							"maximumWarning": "4kb",
							"maximumError": "8kb"
						}
					],
					"outputHashing": "all"
				},
				"development": {
					"optimization": false,
					"extractLicenses": false,
					"sourceMap": true
				}
			}
		},
		"serve": {
			"continuous": true,
			"executor": "@angular/build:dev-server",
			"defaultConfiguration": "development",
			"readyWhen": {
				"signal": true
			},
			"options": {
				"host": "127.0.0.1",
				"port": 4210
			},
			"configurations": {
				"production": {
					"buildTarget": "z21-ui:build:production"
				},
				"development": {
					"buildTarget": "z21-ui:build:development"
				}
			}
		},
		"test": {
			"executor": "@angular/build:unit-test",
			"options": {
				"tsConfig": "apps/z21-ui/tsconfig.spec.json",
				"runnerConfig": "apps/z21-ui/vitest.config.mts",
				"coverage": true,
				"coverageInclude": ["apps/z21-ui/src/**/*.ts"],
				"coverageExclude": ["libs/**/*.ts"],
				"coverageReporters": ["html", "text", "lcov"],
				"reporters": [["html", { "outputDir": "test-result/apps/z21-ui" }], "default", "verbose"]
			}
		},
		"serve-static": {
			"continuous": true,
			"executor": "@nx/web:file-server",
			"options": {
				"buildTarget": "z21-ui:build",
				"port": 4210,
				"staticFilePath": "dist/apps/z21-ui/browser",
				"spa": true,
				"host": "127.0.0.1"
			},
			"readyWhen": {
				"signal": true
			},
			"dependsOn": ["build"]
		},
		"stylelint": {
			"executor": "nx-stylelint:lint"
		},
		"typecheck": {
			"executor": "nx:noop",
			"dependsOn": ["typecheck-app", "typecheck-test"]
		},
		"typecheck-test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.spec.json --noEmit"
			}
		},
		"typecheck-app": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.app.json --noEmit"
			}
		}
	}
}
