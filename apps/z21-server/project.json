{
	"name": "z21-server",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/z21-server/src",
	"projectType": "application",
	"tags": ["type:server-app", "scope:z21", "platform:node"],
	"targets": {
		"build": {
			"executor": "@nx/esbuild:esbuild",
			"outputs": ["{options.outputPath}"],
			"defaultConfiguration": "production",
			"options": {
				"platform": "node",
				"outputPath": "dist/apps/z21-server",
				"format": ["cjs"],
				"bundle": false,
				"main": "apps/z21-server/src/main.ts",
				"tsConfig": "apps/z21-server/tsconfig.app.json",
				"assets": ["apps/z21-server/src/assets"],
				"esbuildOptions": {
					"sourcemap": true,
					"outExtension": {
						".js": ".js"
					}
				}
			},
			"configurations": {
				"development": {},
				"production": {
					"esbuildOptions": {
						"sourcemap": false,
						"outExtension": {
							".js": ".js"
						}
					}
				}
			}
		},
		"serve": {
			"continuous": true,
			"executor": "@nx/js:node",
			"defaultConfiguration": "development",
			"dependsOn": ["build"],
			"options": {
				"buildTarget": "z21-server:build",
				"runBuildTargetDependencies": false
			},
			"configurations": {
				"development": {
					"buildTarget": "z21-server:build:development"
				},
				"production": {
					"buildTarget": "z21-server:build:production"
				}
			}
		},
		"test": {
			"executor": "@nx/vitest:test",
			"options": {
				"tsConfig": "apps/z21-server/tsconfig.spec.json",
				"vitestConfig": "apps/z21-server/vitest.config.mts",
				"reportsDirectory": "test-result/apps/z21-server/coverage",
				"passWithNoTests": true
			},
			"outputs": ["{options.reportsDirectory}"]
		},
		"typecheck": {
			"executor": "nx:noop",
			"dependsOn": ["typecheck-app", "typecheck-test"]
		},
		"typecheck-test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.spec.json --noEmit"
			}
		},
		"typecheck-app": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.app.json --noEmit"
			}
		}
	}
}
