{
	"name": "z21-server-e2e",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"tags": ["type:e2e", "scope:z21", "platform:node"],
	"implicitDependencies": ["z21-server"],
	"targets": {
		"e2e": {
			"outputs": ["{workspaceRoot}/test-result/{projectRoot}"],
			"dependsOn": ["z21-server:build"],
			"options": {
				"cwd": ".",
				"command": "vitest --config apps/z21-server-e2e/vitest.config.mts",
				"coverage": true,
				"passWithNoTests": true
			},
			"configurations": {
				"ci": {
					"command": "vitest run --config apps/z21-server-e2e/vitest.config.ci.mts",
					"coverage": true
				}
			}
		},
		"typecheck": {
			"executor": "nx:noop",
			"dependsOn": ["typecheck-e2e", "typecheck-test"]
		},
		"typecheck-e2e": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.json --noEmit"
			}
		},
		"typecheck-test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.spec.json --noEmit"
			}
		}
	}
}
