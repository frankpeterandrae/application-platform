{
	"name": "stream-overlay-ui",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"prefix": "stream-overlay",
	"sourceRoot": "apps/stream-overlay-ui/src",
	"tags": ["platform:browser", "scope:stream", "type:ui-app"],
	"targets": {
		"build": {
			"executor": "@angular/build:application",
			"outputs": ["{options.outputPath}"],
			"defaultConfiguration": "production",
			"options": {
				"outputPath": "dist/apps/stream-overlay-ui",
				"browser": "apps/stream-overlay-ui/src/main.ts",
				"tsConfig": "apps/stream-overlay-ui/tsconfig.app.json",
				"inlineStyleLanguage": "scss",
				"assets": [
					{
						"glob": "**/*",
						"input": "apps/stream-overlay-ui/public"
					},
					{
						"glob": "**/*",
						"input": "libs/shared/ui-theme/src/assets",
						"output": "assets/theme"
					},
					{
						"glob": "**/*",
						"input": "libs/stream-overlay/overlay/src/assets",
						"output": "assets/stream-overlay"
					}
				],
				"styles": ["apps/stream-overlay-ui/src/styles.scss", "libs/shared/ui-theme/src/lib/theme/themes/stream-overlay.scss"]
			},
			"configurations": {
				"production": {
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "2mb",
							"maximumError": "5mb"
						},
						{
							"type": "anyComponentStyle",
							"maximumError": "6kb"
						}
					]
				},
				"development": {
					"optimization": false,
					"extractLicenses": false,
					"sourceMap": true
				}
			}
		},
		"serve": {
			"executor": "@angular/build:dev-server",
			"defaultConfiguration": "development",
			"continuous": true,
			"dependsOn": ["stream-overlay-server:serve"],
			"readyWhen": {
				"signal": true
			},
			"options": {
				"host": "127.0.0.1",
				"port": 4220,
				"proxyConfig": "apps/stream-overlay-ui/proxy.conf.json"
			},
			"configurations": {
				"production": {
					"buildTarget": "stream-overlay-ui:build:production"
				},
				"development": {
					"buildTarget": "stream-overlay-ui:build:development"
				}
			}
		},
		"test": {
			"executor": "@angular/build:unit-test",
			"options": {
				"tsConfig": "apps/stream-overlay-ui/tsconfig.spec.json",
				"runnerConfig": "apps/stream-overlay-ui/vitest.config.mts",
				"coverage": true,
				"coverageInclude": ["apps/stream-overlay-ui/src/**/*.ts"],
				"coverageExclude": ["libs/**/*.ts"],
				"coverageReporters": ["html", "text", "lcov"],
				"reporters": [["html", { "outputDir": "test-result/apps/stream-overlay-ui" }], "default", "verbose"]
			}
		},
		"serve-static": {
			"continuous": true,
			"executor": "@nx/web:file-server",
			"options": {
				"buildTarget": "stream-overlay-ui:build",
				"port": 4220,
				"staticFilePath": "dist/apps/stream-overlay-ui/browser",
				"spa": true,
				"host": "127.0.0.1"
			},
			"readyWhen": {
				"signal": true
			},
			"dependsOn": ["build"]
		},
		"stylelint": {
			"executor": "nx-stylelint:lint"
		},
		"typecheck": {
			"executor": "nx:noop",
			"dependsOn": ["typecheck-app", "typecheck-test"]
		},
		"typecheck-test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.spec.json --noEmit"
			}
		},
		"typecheck-app": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.app.json --noEmit"
			}
		}
	}
}
