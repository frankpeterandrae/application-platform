{
	"name": "stream-overlay-server",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/stream-overlay-server/src",
	"projectType": "application",
	"tags": ["platform:nestJS", "scope:stream", "type:server-app"],
	"targets": {
		"build": {
			"inputs": [
				"production",
				"^production",
				{
					"json": "{workspaceRoot}/tsconfig.json",
					"fields": ["extends", "files", "include"]
				}
			],
			"outputs": ["{workspaceRoot}/dist/apps/stream-overlay-server"],
			"defaultConfiguration": "production",
			"configurations": {
				"development": {},
				"production": {}
			}
		},
		"migrate-db": {
			"executor": "nx:run-commands",
			"cache": false,
			"options": {
				"command": "tsx --tsconfig tsconfig.base.json tools/database/db-migrate.ts --db data/stream-overlay.db --namespace paint --migrations libs/stream-overlay/paint-data-access/src/lib/schema"
			}
		},
		"import-db": {
			"executor": "nx:run-commands",
			"cache": false,
			"dependsOn": ["migrate-db"],
			"options": {
				"command": "tsx --tsconfig tsconfig.base.json tools/database/db-import.ts --db data/stream-overlay.db --data libs/stream-overlay/paint-data-access/data"
			}
		},
		"serve": {
			"continuous": true,
			"executor": "@nx/js:node",
			"defaultConfiguration": "development",
			"dependsOn": ["typecheck", "import-db", "build"],
			"options": {
				"buildTarget": "stream-overlay-server:build",
				"runBuildTargetDependencies": false
			},
			"configurations": {
				"development": {
					"buildTarget": "stream-overlay-server:build:development"
				},
				"production": {
					"buildTarget": "stream-overlay-server:build:production"
				}
			}
		},
		"test": {
			"options": {
				"cwd": ".",
				"command": "vitest --config apps/stream-overlay-server/vitest.config.mts"
			},
			"outputs": ["{workspaceRoot}/test-result/{projectRoot}"]
		},
		"typecheck": {
			"executor": "nx:noop",
			"dependsOn": ["typecheck-app", "typecheck-test"]
		},
		"typecheck-test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.spec.json --noEmit"
			}
		},
		"typecheck-app": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.app.json --noEmit"
			}
		}
	}
}
