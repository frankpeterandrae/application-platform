{
	"name": "starmap",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"prefix": "starmap",
	"sourceRoot": "apps/starmap/src",
	"tags": ["type:ui-app", "scope:starmap", "platform:browser"],
	"targets": {
		"build": {
			"executor": "@angular/build:application",
			"outputs": ["{options.outputPath}"],
			"defaultConfiguration": "production",
			"options": {
				"outputPath": "dist/apps/starmap",
				"browser": "apps/starmap/src/main.ts",
				"tsConfig": "apps/starmap/tsconfig.app.json",
				"inlineStyleLanguage": "scss",
				"assets": [
					{
						"glob": "**/*",
						"input": "apps/starmap/public"
					},
					{
						"glob": "**/*",
						"input": "libs/shared/ui-theme/src/assets",
						"output": "assets/theme"
					},
					{
						"glob": "**/*",
						"input": "libs/starmap/map/src/assets",
						"output": "assets/map"
					},
					{
						"glob": "**/*",
						"input": "libs/starmap/editor/src/assets",
						"output": "assets/editor"
					}
				],
				"styles": ["apps/starmap/src/styles.scss", "libs/shared/ui-theme/src/lib/theme/themes/starmap-theme.scss"]
			},
			"configurations": {
				"production": {
					"budgets": [
						{
							"type": "initial",
							"maximumWarning": "2mb",
							"maximumError": "5mb"
						},
						{
							"type": "anyComponentStyle",
							"maximumError": "6kb"
						}
					],
					"fileReplacements": [
						{
							"replace": "apps/starmap/src/environments/environment.ts",
							"with": "apps/starmap/src/environments/environment.prod.ts"
						}
					]
				},
				"development": {
					"optimization": false,
					"extractLicenses": false,
					"sourceMap": true
				}
			}
		},
		"serve": {
			"executor": "@angular/build:dev-server",
			"defaultConfiguration": "development",
			"continuous": true,
			"readyWhen": {
				"signal": true
			},
			"options": {
				"host": "127.0.0.1",
				"port": 4230
			},
			"configurations": {
				"production": {
					"buildTarget": "starmap:build:production"
				},
				"development": {
					"buildTarget": "starmap:build:development"
				}
			}
		},
		"test": {
			"executor": "@angular/build:unit-test",
			"options": {
				"tsConfig": "apps/starmap/tsconfig.spec.json",
				"runnerConfig": "apps/starmap/vitest.config.mts",
				"coverage": true,
				"coverageInclude": ["apps/starmap/src/**/*.ts"],
				"coverageExclude": ["libs/**/*.ts"],
				"coverageReporters": ["html", "text", "lcov"],
				"reporters": [["html", { "outputDir": "test-result/apps/starmap" }], "default", "verbose"]
			}
		},
		"serve-static": {
			"continuous": true,
			"executor": "@nx/web:file-server",
			"options": {
				"buildTarget": "starmap:build",
				"port": 4230,
				"staticFilePath": "dist/apps/starmap/browser",
				"spa": true,
				"host": "127.0.0.1"
			},
			"readyWhen": {
				"signal": true
			},
			"dependsOn": ["build"]
		},
		"stylelint": {
			"executor": "nx-stylelint:lint"
		},
		"typecheck": {
			"executor": "nx:noop",
			"dependsOn": ["typecheck-app", "typecheck-test"]
		},
		"typecheck-test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.spec.json --noEmit"
			}
		},
		"typecheck-app": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.app.json --noEmit"
			}
		},
		"desktop-dev": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tauri dev"
			}
		},
		"desktop-build": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tauri build"
			}
		}
	}
}
