{
	"name": "z21-ui-e2e",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/z21-ui-e2e/src",
	"tags": ["type:e2e", "scope:z21", "platform:browser"],
	"implicitDependencies": ["z21-ui"],
	"targets": {
		"e2e": {
			"outputs": ["{workspaceRoot}/test-result/apps/z21-ui-e2e"]
		},
		"typecheck": {
			"executor": "nx:noop",
			"dependsOn": ["typecheck-e2e"]
		},
		"typecheck-e2e": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.json --noEmit"
			}
		}
	}
}
