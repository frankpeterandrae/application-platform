{
	"name": "paint-selector-plugin",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/streamdeck/paint-selector-plugin/src",
	"projectType": "application",
	"tags": ["platform:node", "scope:stream", "type:app"],
	"targets": {
		"build": {
			"executor": "@nx/esbuild:esbuild",
			"outputs": ["{options.outputPath}"],
			"defaultConfiguration": "production",
			"options": {
				"platform": "node",
				"outputPath": "dist/apps/streamdeck/paint-selector-plugin/build",
				"format": ["esm"],
				"bundle": true,
				"main": "apps/streamdeck/paint-selector-plugin/src/main.ts",
				"tsConfig": "apps/streamdeck/paint-selector-plugin/tsconfig.app.json",
				"assets": ["apps/streamdeck/paint-selector-plugin/src/assets"],
				"esbuildOptions": {
					"sourcemap": true,
					"outExtension": {
						".js": ".js"
					}
				}
			},
			"configurations": {
				"development": {},
				"production": {
					"esbuildOptions": {
						"sourcemap": false,
						"outExtension": {
							".js": ".js"
						}
					}
				}
			}
		},
		"package-plugin": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"options": {
				"commands": [
					"shx mkdir -p dist/apps/streamdeck/paint-selector-plugin/de.frankpeterandrae.paint-selector.sdPlugin/bin",
					"shx cp apps/streamdeck/paint-selector-plugin/de.frankpeterandrae.paint-selector.sdPlugin/manifest.json dist/apps/streamdeck/paint-selector-plugin/de.frankpeterandrae.paint-selector.sdPlugin/",
					"shx cp -r apps/streamdeck/paint-selector-plugin/de.frankpeterandrae.paint-selector.sdPlugin/imgs dist/apps/streamdeck/paint-selector-plugin/de.frankpeterandrae.paint-selector.sdPlugin/",
					"shx cp apps/streamdeck/paint-selector-plugin/de.frankpeterandrae.paint-selector.sdPlugin/package.json dist/apps/streamdeck/paint-selector-plugin/de.frankpeterandrae.paint-selector.sdPlugin/",
					"shx cp -r apps/streamdeck/paint-selector-plugin/de.frankpeterandrae.paint-selector.sdPlugin/profiles dist/apps/streamdeck/paint-selector-plugin/de.frankpeterandrae.paint-selector.sdPlugin/",
					"shx cp dist/apps/streamdeck/paint-selector-plugin/build/main.js dist/apps/streamdeck/paint-selector-plugin/de.frankpeterandrae.paint-selector.sdPlugin/bin/main.js"
				],
				"parallel": false
			}
		},
		"link-plugin": {
			"executor": "nx:run-commands",
			"dependsOn": ["package-plugin"],
			"options": {
				"command": "npx streamdeck link dist/apps/streamdeck/paint-selector-plugin/de.frankpeterandrae.paint-selector.sdPlugin"
			}
		},
		"restart-plugin": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx streamdeck restart de.frankpeterandrae.paint-selector"
			}
		},
		"deploy-plugin": {
			"executor": "nx:run-commands",
			"dependsOn": ["package-plugin"],
			"options": {
				"command": "npx streamdeck restart de.frankpeterandrae.paint-selector"
			}
		},
		"pack-plugin": {
			"executor": "nx:run-commands",
			"dependsOn": ["test", "typecheck", "package-plugin"],
			"options": {
				"command": "npx streamdeck pack dist/apps/streamdeck/paint-selector-plugin/de.frankpeterandrae.paint-selector.sdPlugin --output dist/apps/streamdeck/paint-selector-plugin --force --no-update-check"
			}
		},
		"test": {
			"options": {
				"cwd": ".",
				"command": "vitest --config apps/streamdeck/paint-selector-plugin/vitest.config.mts"
			},
			"outputs": ["{workspaceRoot}/test-result/{projectRoot}"]
		},
		"typecheck": {
			"executor": "nx:noop",
			"dependsOn": ["typecheck-app", "typecheck-test"]
		},
		"typecheck-test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.spec.json --noEmit"
			}
		},
		"typecheck-app": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.app.json --noEmit"
			}
		}
	}
}
