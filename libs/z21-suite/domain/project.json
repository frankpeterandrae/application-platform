{
	"name": "domain",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "libs/z21-suite/domain/src",
	"projectType": "library",
	"tags": ["type:domain", "scope:z21", "platform:agnostic"],
	"targets": {
		"test": {
			"options": {
				"cwd": ".",
				"command": "vitest --config libs/z21-suite/domain/vitest.config.mts"
			},
			"outputs": ["{workspaceRoot}/test-result/{projectRoot}"]
		},
		"typecheck": {
			"executor": "nx:noop",
			"dependsOn": ["typecheck-lib", "typecheck-test"]
		},
		"typecheck-test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.spec.json --noEmit"
			}
		},
		"typecheck-lib": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.lib.json --noEmit"
			}
		}
	}
}
