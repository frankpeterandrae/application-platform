{
	"name": "shared-ui-theme",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "libs/shared/ui-theme/src",
	"prefix": "theme",
	"projectType": "library",
	"tags": ["type:ui", "scope:shared", "platform:browser"],
	"metadata": {
		"assets": [
			{
				"glob": "**/*",
				"input": "{projectRoot}/src/assets",
				"output": "assets"
			}
		]
	},
	"targets": {
		"test": {
			"options": {
				"cwd": ".",
				"command": "vitest --config libs/shared/ui-theme/vitest.config.mts"
			},
			"outputs": ["{workspaceRoot}/test-result/{projectRoot}"]
		},
		"watch-css": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npm run watch:shared-styles",
				"cwd": "scripts",
				"parallel": false
			}
		},
		"stylelint": {
			"executor": "nx-stylelint:lint"
		},
		"typecheck": {
			"executor": "nx:noop",
			"dependsOn": ["typecheck-lib", "typecheck-test"]
		},
		"typecheck-test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.spec.json --noEmit"
			}
		},
		"typecheck-lib": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.lib.json --noEmit"
			}
		}
	}
}
