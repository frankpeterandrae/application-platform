{
	"name": "testing",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "libs/shared/testing/src",
	"prefix": "lib",
	"projectType": "library",
	"tags": ["type:testing", "scope:shared", "platform:browser"],
	"targets": {
		"typecheck": {
			"executor": "nx:noop",
			"dependsOn": ["typecheck-lib"]
		},
		"typecheck-lib": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.lib.json --noEmit"
			}
		}
	}
}
