{
	"name": "colour-rack",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "libs/homepage/colour-rack/src",
	"prefix": "lib",
	"projectType": "library",
	"tags": ["type:feature", "scope:homepage", "scope:demo", "platform:browser"],
	"implicitDependencies": ["stream-overlay-paint-data-access"],
	"targets": {
		"export-assets": {
			"executor": "nx:run-commands",
			"cache": false,
			"options": {
				"command": "tsx libs/homepage/colour-rack/tools/export-colour-rack.ts"
			}
		},
		"verify-assets": {
			"executor": "nx:run-commands",
			"cache": false,
			"options": {
				"command": "tsx libs/homepage/colour-rack/tools/export-colour-rack.ts --check"
			}
		},
		"test": {
			"options": {
				"cwd": ".",
				"command": "vitest --config libs/homepage/colour-rack/vitest.config.mts"
			},
			"outputs": ["{workspaceRoot}/test-result/{projectRoot}"]
		},
		"stylelint": {
			"executor": "nx-stylelint:lint"
		},
		"typecheck": {
			"executor": "nx:noop",
			"dependsOn": ["typecheck-lib", "typecheck-test"]
		},
		"typecheck-test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.spec.json --noEmit"
			}
		},
		"typecheck-lib": {
			"executor": "nx:run-commands",
			"options": {
				"command": "npx tsc -p {projectRoot}/tsconfig.lib.json --noEmit"
			}
		}
	}
}
