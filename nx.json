{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"targetDefaults": {
		"lint": [
			{
				"filter": { "plugin": "@nx/eslint/plugin" },
				"outputs": ["{projectRoot}/{options.output-file}"]
			}
		],
		"build": {
			"cache": true,
			"dependsOn": ["^build"],
			"inputs": ["production", "^production"]
		},
		"e2e": {
			"cache": true,
			"inputs": ["default", "^production"]
		},
		"stylelint": {
			"cache": true,
			"inputs": ["default", "{workspaceRoot}/.stylelintrc(.(json|yml|yaml|js))?"],
			"options": {
				"lintFilePatterns": ["{projectRoot}/**/*.css", "{projectRoot}/**/*.scss"]
			}
		},
		"@angular/build:application": {
			"cache": true,
			"dependsOn": ["^build"],
			"inputs": ["production", "^production"]
		},
		"@nx/esbuild:esbuild": {
			"cache": true,
			"dependsOn": ["^build"],
			"inputs": ["production", "^production"]
		},
		"@nx/js:tsc": {
			"cache": true,
			"dependsOn": ["^build"],
			"inputs": ["production", "^production"]
		},
		"@angular/build:unit-test": {
			"cache": true,
			"inputs": ["default", "^production"]
		},
		"test": [
			{
				"filter": {
					"plugin": "@nx/vitest"
				},
				"outputs": ["{workspaceRoot}/test-result/{projectRoot}"],
				"configurations": {
					"ci": {
						"coverage": true,
						"run": true
					}
				},
				"options": {
					"coverage": true,
					"passWithNoTests": true
				}
			}
		]
	},
	"namedInputs": {
		"default": ["{projectRoot}/**/*", "sharedGlobals"],
		"production": [
			"default",
			"!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
			"!{projectRoot}/tsconfig.spec.json",
			"!{projectRoot}/src/test-setup.[jt]s",
			"!{projectRoot}/test-setup.[jt]s",
			"!{projectRoot}/.eslintrc.json",
			"!{projectRoot}/eslint.config.mjs",
			"!{projectRoot}/.stylelintrc(.(json|yml|yaml|js))?"
		],
		"sharedGlobals": []
	},
	"plugins": [
		{
			"plugin": "@nx/playwright/plugin",
			"options": {
				"targetName": "e2e"
			}
		},
		{
			"plugin": "@nx/eslint/plugin",
			"options": {
				"targetName": "lint"
			}
		},
		{
			"plugin": "@nx/vitest",
			"options": {
				"testMode": "watch",
				"testTargetName": "test"
			},
			"include": [
				"apps/stream-overlay-server/**/*",
				"apps/streamdeck/paint-selector-plugin/**/*",
				"apps/streamdeck/yamaha-tsr700/**/*",
				"apps/z21-server/**/*",
				"libs/demo/demo-feature/**/*",
				"libs/homepage/colour-rack/**/*",
				"libs/homepage/homepage-feature/**/*",
				"libs/shared/config/**/*",
				"libs/shared/data-db/**/*",
				"libs/shared/paint/**/*",
				"libs/shared/shared-ui/**/*",
				"libs/shared/ui-theme/**/*",
				"libs/starmap/data-access/**/*",
				"libs/starmap/domain/**/*",
				"libs/starmap/editor/**/*",
				"libs/starmap/map/**/*",
				"libs/starmap/renderer-3d/**/*",
				"libs/stream-overlay/dashboard/**/*",
				"libs/stream-overlay/data-access/**/*",
				"libs/stream-overlay/overlay/**/*",
				"libs/stream-overlay/paint-api/**/*",
				"libs/stream-overlay/paint-data-access/**/*",
				"libs/stream-overlay/paint-protocol/**/*",
				"libs/stream-overlay/paint-selector/**/*",
				"libs/z21-suite/domain/**/*",
				"libs/z21-suite/protocol/**/*",
				"libs/z21-suite/server-utils/**/*",
				"libs/z21-suite/shared/**/*",
				"libs/z21-suite/z21/**/*"
			]
		},
		{
			"plugin": "@nx/vitest",
			"options": {
				"testMode": "watch",
				"testTargetName": "e2e"
			},
			"include": ["apps/z21-server-e2e/**/*"]
		},
		{
			"plugin": "@nx/webpack/plugin",
			"options": {
				"buildTargetName": "build",
				"previewTargetName": "preview",
				"serveStaticTargetName": "serve-static",
				"serveTargetName": "serve"
			}
		}
	],
	"neverConnectToCloud": true,
	"useInferencePlugins": false,
	"defaultBase": "main",
	"generators": {
		"@nx/angular:application": {
			"e2eTestRunner": "playwright",
			"linter": "eslint",
			"style": "scss",
			"unitTestRunner": "vitest-angular"
		},
		"@nx/angular:component": {
			"style": "scss"
		},
		"@nx/angular:library": {
			"linter": "eslint",
			"unitTestRunner": "vitest-analog"
		}
	},
	"analytics": false,
	"affected": {
		"legacy": true
	}
}
