{
	"compileOnSave": false,
	"compilerOptions": {
		"rootDir": ".",
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"sourceMap": true,
		"declaration": false,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"importHelpers": true,
		"module": "esnext",
		"target": "ES2022",
		"moduleResolution": "bundler",
		"lib": ["DOM", "ES2022"],
		"skipLibCheck": true,
		"skipDefaultLibCheck": true,
		"strictNullChecks": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"baseUrl": ".",
		"ignoreDeprecations": "6.0",
		"paths": {
			"@application-platform/colour-rack": ["libs/homepage/colour-rack/src/index.ts"],
			"@application-platform/config": ["libs/shared/config/src/index.ts"],
			"@application-platform/data-db": ["libs/shared/data-db/src/index.ts"],
			"@application-platform/demo-feature": ["libs/demo/demo-feature/src/index.ts"],
			"@application-platform/domain": ["libs/z21-suite/domain/src/index.ts"],
			"@application-platform/homepage-feature": ["libs/homepage/homepage-feature/src/index.ts"],
			"@application-platform/interfaces": ["libs/shared/interfaces/src/index.ts"],
			"@application-platform/paint": ["./libs/shared/paint/src/index.ts"],
			"@application-platform/paint-selector": ["./libs/stream-overlay/paint-selector/src/index.ts"],
			"@application-platform/protocol": ["libs/z21-suite/protocol/src/index.ts"],
			"@application-platform/server-utils": ["libs/z21-suite/server-utils/src/index.ts"],
			"@application-platform/shared-node-test": ["libs/shared/shared-node-test/src/index.ts"],
			"@application-platform/shared-ui": ["libs/shared/shared-ui/src/index.ts"],
			"@application-platform/shared/ui-theme": ["libs/shared/ui-theme/src/index.ts"],
			"@application-platform/testing": ["libs/shared/testing/src/index.ts"],
			"@application-platform/testing/analog": ["libs/shared/testing/src/analog.ts"],
			"@application-platform/z21": ["libs/z21-suite/z21/src/index.ts"],
			"@application-platform/z21-shared": ["libs/z21-suite/shared/src/index.ts"],
			"@application-platform/stream-overlay-dashboard": ["./libs/stream-overlay/dashboard/src/index.ts"],
			"@application-platform/stream-overlay": ["./libs/stream-overlay/overlay/src/index.ts"],
			"@application-platform/stream-overlay-data-access": ["./libs/stream-overlay/data-access/src/index.ts"],
			"@application-platform/paint-protocol": ["./libs/stream-overlay/paint-protocol/src/index.ts"],
			"@application-platform/stream-overlay-paint-api": ["./libs/stream-overlay/paint-api/src/index.ts"],
			"@application-platform/paint-data-access": ["./libs/stream-overlay/paint-data-access/src/index.ts"]
		},
		"noImplicitOverride": true,
		"noPropertyAccessFromIndexSignature": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": false,
		"types": ["vitest/globals", "node"]
	},
	"exclude": ["node_modules", "tmp"],
	"include": ["global.d.ts", "tools/**/*", "libs/**/*", "apps/**/*", "scripts/**/*", "vitest.setup.ts", "types/**/*"]
}
