{
	"name": "@application-platform/source",
	"version": "0.0.0",
	"license": "MIT",
	"scripts": {
		"nx": "nx",
		"start": "nx run homepage:serve",
		"serve": "nx run-many -t serve --projects=homepage,demo --parallel=2",
		"serve:homepage": "nx run homepage:serve",
		"serve:demo": "nx run demo:serve",
		"build": "nx run-many -t build --all",
		"build:homepage": "nx run homepage:build",
		"build:demo": "nx run demo:build",
		"lint": "nx run-many -t lint --all",
		"lint:fix": "nx run-many -t lint --all --fix",
		"lint:staged": "nx affected -t lint --fix --files",
		"test": "nx run-many -t test --all",
		"test:no-cache": "nx run-many -t test --all --skip-nx-cache",
		"e2e": "nx run-many -t e2e --all --skip-nx-cache",
		"format": "prettier --config .prettierrc --log-level warn \"**/*.{ts,mts,js,json,scss,html,mjs}\" --ignore-path .gitignore",
		"format:check": "npm run format -- --check",
		"format:fix": "npm run format -- --write",
		"graph": "nx graph",
		"dep-graph": "nx dep-graph",
		"reset": "nx reset",
		"clean": "npm run reset && rimraf dist coverage tmp .angular",
		"update": "nx migrate latest",
		"help": "nx help",
		"prepare": "husky",
		"watch:shared-styles": "node scripts/watch-css.js",
		"serve:watch": "concurrently \"nx run start\" \"nx run shared-ui-theme:watch-css\"",
		"countlines": "cloc . --exclude-dir=.angular,.husky,.idea,.nx,.vscode,dist,node_modules,tmp,coverage --exclude-list-file=package-lock.json",
		"foss": "license-checker --json --production --customPath licenseFormat.json --out tmp/foss-licenses.json && node ./scripts/combine-licenses.js",
		"release": "node tools/release.mjs"
	},
	"private": true,
	"dependencies": {
		"@angular/animations": "22.1.1",
		"@angular/cdk": "22.1.1",
		"@angular/common": "22.1.1",
		"@angular/compiler": "22.1.1",
		"@angular/core": "22.1.1",
		"@angular/forms": "22.1.1",
		"@angular/platform-browser": "22.1.1",
		"@angular/platform-browser-dynamic": "22.1.1",
		"@angular/router": "22.1.1",
		"@jsverse/transloco": "^8.4.0",
		"@nx/angular": "23.1.1",
		"@push-based/ngx-fast-svg": "^18.1.0",
		"axios": "^1.19.0",
		"organize-imports-cli": "^1.0.2",
		"prismjs": "^1.30.0",
		"rxjs": "~7.8.2",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@analogjs/vite-plugin-angular": "^2.6.4",
		"@angular-devkit/build-angular": "22.1.3",
		"@angular-devkit/core": "22.1.3",
		"@angular-devkit/schematics": "22.1.3",
		"@angular-eslint/eslint-plugin": "22.1.0",
		"@angular-eslint/eslint-plugin-template": "22.1.0",
		"@angular-eslint/schematics": "22.1.0",
		"@angular-eslint/template-parser": "22.1.0",
		"@angular/build": "22.1.3",
		"@angular/cli": "22.1.3",
		"@angular/compiler-cli": "22.1.1",
		"@angular/language-service": "22.1.1",
		"@eslint/eslintrc": "^3.3.6",
		"@eslint/js": "^9.0.0",
		"@nx/devkit": "23.1.1",
		"@nx/esbuild": "23.1.1",
		"@nx/eslint": "23.1.1",
		"@nx/eslint-plugin": "23.1.1",
		"@nx/jest": "23.1.1",
		"@nx/js": "23.1.1",
		"@nx/node": "23.1.1",
		"@nx/playwright": "23.1.1",
		"@nx/vite": "23.1.1",
		"@nx/vitest": "23.1.1",
		"@nx/web": "23.1.1",
		"@nx/workspace": "23.1.1",
		"@playwright/test": "^1.62.1",
		"@prettier/plugin-php": "^0.25.0",
		"@swc-node/register": "1.12.1",
		"@swc/core": "1.15.47",
		"@swc/helpers": "0.5.21",
		"@types/jest": "^30.0.0",
		"@types/node": "26.2.0",
		"@types/prismjs": "^1.26.6",
		"@typescript-eslint/eslint-plugin": "8.67.0",
		"@typescript-eslint/parser": "8.67.0",
		"@typescript-eslint/utils": "8.67.0",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"angular-eslint": "22.1.0",
		"concurrently": "^10.0.4",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-formatter-unix": "^9.0.1",
		"eslint-plugin-cypress": "^6.0.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^64.0.2",
		"eslint-plugin-playwright": "^2.11.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"jsonc-eslint-parser": "^3.3.0",
		"license-checker": "^25.0.1",
		"lint-staged": "^17.3.0",
		"npm-check-updates": "^23.0.2",
		"nx": "23.1.1",
		"nx-stylelint": "^19.0.0",
		"prettier": "~3.9.6",
		"rimraf": "^6.1.3",
		"sass": "^1.102.0",
		"sass-migrator": "2.6.1",
		"shx": "^0.4.0",
		"stylelint": "^17.14.1",
		"stylelint-config-standard": "40.0.0",
		"stylelint-config-standard-scss": "17.0.0",
		"ts-node": "10.9.2",
		"typescript": "6.0.3",
		"typescript-eslint": "8.67.0",
		"vite": "^8.2.1",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.10"
	},
	"lint-staged": {
		"*.{css,scss}": [
			"stylelint --fix",
			"prettier --config .prettierrc --write"
		],
		"*.{js,jsx,ts}": [
			"organize-imports-cli",
			"node scripts/sort-exports.js",
			"node scripts/build-translation-files.js",
			"npm run lint:staged --silent",
			"prettier --config .prettierrc --write"
		],
		"*.{md,json,html,php}": [
			"prettier --config .prettierrc --write"
		]
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"esbuild@0.28.2": true,
		"@swc/core@1.15.47": true,
		"@parcel/watcher@2.6.0": true,
		"lmdb@3.5.6": true,
		"msgpackr-extract@3.0.4": true,
		"unrs-resolver@1.12.2": true,
		"less@4.5.1": true,
		"less@4.6.7": true,
		"nx@23.1.1": true
	}
}
