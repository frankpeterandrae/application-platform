{
	"name": "@application-platform/source",
	"version": "0.0.0",
	"license": "MIT",
	"scripts": {
		"build": "nx run-many -t build --all",
		"build:demo": "nx run demo:build",
		"build:homepage": "nx run homepage:build",
		"clean": "npm run reset && rimraf dist test-result tmp .angular",
		"countlines": "cloc . --exclude-dir=.angular,.husky,.idea,.nx,.vscode,dist,node_modules,tmp,test-result --exclude-list-file=package-lock.json",
		"dep-graph": "nx dep-graph",
		"e2e": "nx run-many -t e2e --all --skip-nx-cache",
		"format": "prettier --config .prettierrc --log-level warn \"**/*.{ts,mts,js,json,scss,html,mjs,sql}\" --ignore-path .gitignore",
		"format:check": "npm run format -- --check",
		"format:fix": "npm run format -- --write",
		"foss": "license-checker --json --production --customPath licenseFormat.json --out tmp/foss-licenses.json && node ./scripts/combine-licenses.js",
		"graph": "nx graph",
		"help": "nx help",
		"lint": "nx run-many -t lint --all",
		"lint:fix": "nx run-many -t lint --all --fix",
		"lint:staged": "nx affected -t lint --fix --files",
		"nx": "nx",
		"prepare": "husky",
		"release": "node tools/release.mjs",
		"reset": "nx reset",
		"serve": "nx run-many -t serve --projects=homepage,demo --parallel=2",
		"serve:demo": "nx run demo:serve",
		"serve:homepage": "nx run homepage:serve",
		"serve:watch": "concurrently \"nx run start\" \"nx run shared-ui-theme:watch-css\"",
		"start": "nx run homepage:serve",
		"test": "nx run-many -t test --all",
		"test:no-cache": "nx run-many -t test --all --skip-nx-cache",
		"typecheck": "nx run-many -t typecheck",
		"update": "nx migrate latest",
		"watch:shared-styles": "node scripts/watch-css.js"
	},
	"private": true,
	"dependencies": {
		"@angular/cdk": "22.1.1",
		"@angular/common": "22.1.1",
		"@angular/compiler": "22.1.1",
		"@angular/core": "22.1.1",
		"@angular/forms": "22.1.1",
		"@angular/platform-browser": "22.1.1",
		"@angular/router": "22.1.1",
		"@jsverse/transloco": "^8.4.0",
		"@nestjs/common": "^11.0.0",
		"@nestjs/core": "^11.0.0",
		"@nestjs/platform-express": "^11.0.0",
		"@nestjs/platform-ws": "^11.2.1",
		"@nestjs/websockets": "^11.2.1",
		"@ngrx/signals": "^22.0.0",
		"@push-based/ngx-fast-svg": "^18.1.0",
		"better-sqlite3": "^13.0.3",
		"prismjs": "^1.30.0",
		"reflect-metadata": "^0.2.0",
		"rxjs": "~7.8.2",
		"tslib": "^2.8.1",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@analogjs/vite-plugin-angular": "^2.6.4",
		"@analogjs/vitest-angular": "~2.6.0",
		"@angular-devkit/core": "22.1.3",
		"@angular-devkit/schematics": "22.1.3",
		"@angular/build": "22.1.3",
		"@angular/cli": "22.1.3",
		"@angular/compiler-cli": "22.1.1",
		"@angular/language-service": "22.1.1",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.0",
		"@nx/angular": "^23.1.1",
		"@nx/esbuild": "23.1.1",
		"@nx/eslint": "23.1.1",
		"@nx/eslint-plugin": "23.1.1",
		"@nx/js": "23.1.1",
		"@nx/nest": "^23.1.1",
		"@nx/node": "23.1.1",
		"@nx/playwright": "23.1.1",
		"@nx/vite": "23.1.1",
		"@nx/vitest": "23.1.1",
		"@nx/web": "23.1.1",
		"@nx/webpack": "23.1.1",
		"@oxc-project/runtime": "^0.115.0",
		"@playwright/test": "^1.62.1",
		"@prettier/plugin-php": "^0.25.0",
		"@schematics/angular": "22.1.3",
		"@swc/helpers": "~0.5.18",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.4.1",
		"@types/prismjs": "^1.26.6",
		"@types/ws": "^8.18.1",
		"@typescript-eslint/utils": "^8.58.0",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"angular-eslint": "22.1.0",
		"chokidar": "^5.0.0",
		"cloc": "^2.6.0-cloc",
		"concurrently": "^10.0.4",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^64.0.2",
		"eslint-plugin-playwright": "^2.11.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"jsonc-eslint-parser": "^3.3.0",
		"license-checker": "^25.0.1",
		"lint-staged": "^17.3.0",
		"npm-check-updates": "^23.0.2",
		"nx": "23.1.1",
		"nx-stylelint": "^19.0.0",
		"organize-imports-cli": "^1.0.2",
		"prettier": "~3.9.6",
		"prettier-plugin-embed": "^0.5.1",
		"prettier-plugin-sql": "^0.20.0",
		"rimraf": "^6.1.3",
		"sass": "^1.102.0",
		"shx": "^0.4.0",
		"stylelint": "^17.14.1",
		"stylelint-config-standard": "40.0.0",
		"stylelint-config-standard-scss": "17.0.0",
		"tsx": "^4.23.12",
		"typescript": "6.0.3",
		"typescript-eslint": "8.67.0",
		"vite": "^8.2.1",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.10",
		"webpack": "^5.101.3",
		"webpack-dev-server": "^5.2.1"
	},
	"lint-staged": {
		"*.{css,scss}": [
			"stylelint --fix",
			"prettier --config .prettierrc --write"
		],
		"*.{js,jsx,ts}": [
			"organize-imports-cli",
			"node scripts/sort-exports.js",
			"node scripts/build-translation-files.js",
			"npm run lint:staged --silent",
			"prettier --config .prettierrc --write"
		],
		"*.{md,json,html,php,sql}": [
			"prettier --config .prettierrc --write"
		]
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"esbuild@0.28.2": true,
		"@swc/core@1.15.47": true,
		"@parcel/watcher@2.6.0": true,
		"lmdb@3.5.6": true,
		"msgpackr-extract@3.0.4": true,
		"unrs-resolver@1.12.2": true,
		"less@4.5.1": true,
		"less@4.6.7": true,
		"nx@23.1.1": true
	}
}
