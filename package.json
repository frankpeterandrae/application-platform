{
	"name": "@application-platform/source",
	"version": "0.0.0",
	"license": "MIT",
	"scripts": {
		"build": "nx run-many -t build --all",
		"build:demo": "nx run demo:build",
		"build:homepage": "nx run homepage:build",
		"clean": "npm run reset && rimraf dist test-result tmp .angular",
		"countlines": "cloc . --exclude-dir=.angular,.husky,.idea,.nx,.vscode,dist,node_modules,tmp,test-result --exclude-list-file=package-lock.json",
		"dep-graph": "nx dep-graph",
		"e2e": "nx run-many -t e2e --all --configuration=ci --skip-nx-cache",
		"e2e:install": "playwright install chromium firefox webkit",
		"format": "prettier --config .prettierrc --log-level warn \"**/*.{ts,mts,js,json,scss,html,mjs,sql}\" --ignore-path .gitignore",
		"format:check": "npm run format -- --check",
		"format:fix": "npm run format -- --write",
		"foss": "license-checker --json --production --customPath licenseFormat.json --out tmp/foss-licenses.json && node ./scripts/combine-licenses.js",
		"graph": "nx graph",
		"help": "nx help",
		"lint": "nx run-many -t lint --all",
		"lint:fix": "nx run-many -t lint --all --fix",
		"lint:staged": "nx affected -t lint --fix --files",
		"nx": "nx",
		"prepare": "husky",
		"release": "node tools/release.mjs",
		"reset": "nx reset",
		"serve": "nx run-many -t serve --projects=homepage,demo --parallel=2",
		"serve:demo": "nx run demo:serve",
		"serve:homepage": "nx run homepage:serve",
		"serve:watch": "concurrently \"nx run start\" \"nx run shared-ui-theme:watch-css\"",
		"start": "nx run homepage:serve",
		"test": "nx run-many -t test --all",
		"test:no-cache": "nx run-many -t test --all --skip-nx-cache --watch=false",
		"typecheck": "nx run-many -t typecheck",
		"update": "nx migrate latest",
		"watch:shared-styles": "node scripts/watch-css.js",
		"desktop:starmap": "nx run starmap:desktop-dev",
		"build:starmap:desktop": "nx run starmap:desktop-build",
		"sonar:pr-findings": "tsx tools/sonar/get-pr-findings.ts",
		"coverage:report": "tsx tools/coverage/report.ts",
		"coverage:pr": "tsx tools/coverage/pr.ts"
	},
	"private": true,
	"engines": {
		"node": ">=24.15.0 <25",
		"npm": "10.9.9"
	},
	"dependencies": {
		"@angular/cdk": "22.2.5",
		"@angular/common": "22.2.4",
		"@angular/compiler": "22.2.4",
		"@angular/core": "22.2.4",
		"@angular/forms": "22.2.4",
		"@angular/platform-browser": "22.2.4",
		"@angular/router": "22.2.4",
		"@elgato/streamdeck": "3.0.4",
		"@elgato/utils": "0.6.2",
		"@jsverse/transloco": "^8.4.0",
		"@nestjs/common": "^11.2.8",
		"@nestjs/core": "^11.2.8",
		"@nestjs/platform-express": "^11.2.8",
		"@nestjs/platform-ws": "^11.2.8",
		"@nestjs/websockets": "^11.2.8",
		"@ngrx/signals": "^22.0.1",
		"@push-based/ngx-fast-svg": "22.0.0",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"@tauri-apps/plugin-fs": "^2.7.1",
		"better-sqlite3": "^13.0.3",
		"prismjs": "^1.30.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "~7.8.2",
		"three": "0.187.0",
		"tslib": "^2.9.1",
		"ws": "^8.22.1"
	},
	"devDependencies": {
		"@analogjs/vite-plugin-angular": "2.9.4",
		"@analogjs/vitest-angular": "2.9.4",
		"@angular-devkit/core": "22.2.5",
		"@angular-devkit/schematics": "22.2.5",
		"@angular/build": "22.2.5",
		"@angular/cli": "22.2.5",
		"@angular/compiler-cli": "22.2.4",
		"@angular/language-service": "22.2.4",
		"@elgato/cli": "^1.10.4",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.2.8",
		"@nx/angular": "24.0.3",
		"@nx/devkit": "24.0.3",
		"@nx/esbuild": "24.0.3",
		"@nx/eslint": "24.0.3",
		"@nx/eslint-plugin": "24.0.3",
		"@nx/js": "24.0.3",
		"@nx/nest": "24.0.3",
		"@nx/node": "24.0.3",
		"@nx/playwright": "24.0.3",
		"@nx/vite": "24.0.3",
		"@nx/vitest": "24.0.3",
		"@nx/web": "24.0.3",
		"@nx/webpack": "24.0.3",
		"@playwright/test": "^1.64.1",
		"@prettier/plugin-php": "0.26.0",
		"@schematics/angular": "22.2.5",
		"@tauri-apps/cli": "^2.12.4",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.6",
		"@types/prismjs": "^1.26.6",
		"@types/three": "0.187.0",
		"@types/ws": "^8.18.2",
		"@typescript-eslint/utils": "^8.72.1",
		"@vitest/coverage-v8": "5.0.5",
		"@vitest/ui": "5.0.5",
		"angular-eslint": "22.6.0",
		"chokidar-watcher": "npm:chokidar@6.0.0",
		"cloc": "^2.11.0",
		"concurrently": "^10.0.6",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^64.5.4",
		"eslint-plugin-playwright": "^2.12.1",
		"eslint-plugin-unused-imports": "^4.4.1",
		"husky": "^9.1.7",
		"jsdom": "^30.1.3",
		"jsonc-eslint-parser": "^3.3.0",
		"license-checker": "^25.0.1",
		"lint-staged": "^17.6.0",
		"node-gyp": "12.4.0",
		"npm-check-updates": "^23.1.1",
		"nx": "24.0.3",
		"nx-stylelint": "^19.0.0",
		"organize-imports-cli": "^1.0.2",
		"prettier": "~3.9.10",
		"prettier-plugin-sql": "^0.20.0",
		"rimraf": "^6.1.3",
		"sass": "^1.107.1",
		"shx": "^0.4.0",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "40.0.0",
		"stylelint-config-standard-scss": "17.0.0",
		"tsx": "^4.23.15",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "^8.3.5",
		"vitest": "5.0.5",
		"webpack": "^5.112.2",
		"webpack-cli": "^7.3.1",
		"webpack-dev-server": "^5.2.7"
	},
	"lint-staged": {
		"*.{css,scss}": [
			"stylelint --fix",
			"prettier --config .prettierrc --write"
		],
		"*.{js,jsx,ts}": [
			"organize-imports-cli",
			"node scripts/sort-exports.js",
			"node scripts/build-translation-files.js",
			"npm run lint:staged --silent",
			"prettier --config .prettierrc --write"
		],
		"*.{md,json,html,php,sql}": [
			"prettier --config .prettierrc --write"
		]
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"esbuild@0.28.2": true,
		"@swc/core@1.15.47": true,
		"@parcel/watcher@2.6.0": true,
		"lmdb@3.5.6": true,
		"msgpackr-extract@3.0.4": true,
		"unrs-resolver@1.12.2": true,
		"less@4.5.1": true,
		"less@4.6.7": true,
		"nx@23.1.1": true
	},
	"packageManager": "npm@10.9.9",
	"overrides": {
		"@oxc-parser/binding-wasm32-wasi@0.150.0": {
			"@emnapi/core": "2.0.0-alpha.4",
			"@emnapi/runtime": "2.0.0-alpha.4",
			"@napi-rs/wasm-runtime": "1.2.4"
		},
		"@oxc-parser/binding-wasm32-wasi@0.121.0": {
			"@napi-rs/wasm-runtime": "1.1.1"
		}
	}
}
